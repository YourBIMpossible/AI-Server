# ---- AI-Server config ----
# Copy to .env and edit. Scripts read .env from the repo root. Real environment
# variables override these.

# Inference endpoint (OpenAI-compatible).
#   Current rig:  http://localhost:11434
#   3090 box:     http://<box-hostname-or-tailscale>:11434
#
# NOTE: this is the only line that changes *here*, but relocation is NOT just this line.
# The serving-layer environment (flash attention, context length, keep-alive) lives on the
# host running Ollama, not in this file, and it is worth up to ~150x on prefill. On Linux
# that is set by scripts/setup-linux.sh; anywhere else, set it yourself and verify it from
# the server's startup banner. See decisions/2026-09-10__box-build-reassessment.md.
OLLAMA_HOST=http://localhost:11434

# Workhorse model (used by the smoke test + automations).
#   16GB (RTX 5080): qwen2.5-coder:14b
#   24GB (RTX 3090): pick on evidence, not on this comment -- see config/models.txt.
MODEL=qwen2.5-coder:14b

# Embeddings model for Stage 3 RAG.
EMBED_MODEL=nomic-embed-text

# Where your docs live (read-only source for the digest).
WORKSPACE=F:\BIMpossible-Workspace

# Output folder for generated digests (relative to repo root, or absolute).
OUT=./out

# How many days back the daily digest looks.
DIGEST_DAYS=7

# WP-F eval: a task is "local OK" when its pass-rate clears this threshold (0-1).
EVAL_PASS_THRESHOLD=0.8

# WP-F eval: Claude model used for the optional baseline comparison (only called
# when ANTHROPIC_API_KEY is set).
BASELINE_MODEL=claude-opus-4-8

# OpenWhispr dictation-cleanup proxy (aiserver/dictation_proxy.py). Listen address --
# not the Ollama endpoint, which is still OLLAMA_HOST above.
DICTATION_PROXY_HOST=127.0.0.1
DICTATION_PROXY_PORT=11435
