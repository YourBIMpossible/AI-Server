# ---- AI-Server config ----
# Copy to .env and edit. Scripts read .env from the repo root. Real environment
# variables override these.

# Inference endpoint (OpenAI-compatible).
#   Current rig:  http://localhost:11434
#   3090 box:     http://<box-hostname-or-tailscale>:11434   <- the only line that changes on relocation
OLLAMA_HOST=http://localhost:11434

# Workhorse model (used by the smoke test + automations).
#   16GB (RTX 5080): qwen2.5-coder:14b
#   24GB (RTX 3090): qwen2.5-coder:32b   (or llama3.3:70b for best RAG answers)
MODEL=qwen2.5-coder:14b

# Embeddings model for Stage 3 RAG.
EMBED_MODEL=nomic-embed-text

# Where your docs live (read-only source for the digest).
WORKSPACE=F:\AI-Dev

# Output folder for generated digests (relative to repo root, or absolute).
OUT=./out

# How many days back the daily digest looks.
DIGEST_DAYS=7

# WP-F eval: a task is "local OK" when its pass-rate clears this threshold (0-1).
EVAL_PASS_THRESHOLD=0.8
