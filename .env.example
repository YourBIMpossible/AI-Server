# ---- AI-Server config ----
# Copy to .env and edit. Scripts read .env from the repo root. Real environment
# variables override these.

# ---- The endpoint contract ----
# Everything in this repo talks to ONE thing: a private, OpenAI-compatible HTTP inference
# endpoint. Which program serves it -- Ollama, llama.cpp's llama-server, vLLM -- is a
# deployment choice behind this URL, not something clients know about. Deliberately NOT
# named OLLAMA_HOST: that name both bakes in a runner and collides with Ollama's own
# server-side bind address on the box. A .env still carrying OLLAMA_HOST fails loudly.
#
# Include the /v1 suffix. A bare host:port is accepted and gets /v1 appended; an explicit
# path is used as given, so a gateway mounting the API elsewhere works.
#   Current rig:  http://localhost:11434/v1
#   3090 box:     http://<box-hostname-or-tailscale>:11434/v1
#
# Relocation is NOT just this line. The serving-layer environment (flash attention, context
# length, keep-alive) lives on the host running the endpoint, not in this file, and it is
# worth up to ~150x on prefill. On Linux that is set by scripts/setup-linux.sh; anywhere
# else, set it yourself and verify it from the server's startup banner. See
# decisions/2026-09-10__box-build-reassessment.md.
INFERENCE_BASE_URL=http://localhost:11434/v1

# Bearer token, only if you put an auth gateway in front of the endpoint (WP-E). Blank =
# no Authorization header. Never commit a real value.
INFERENCE_API_KEY=

# Workhorse model (used by the smoke test + automations). This is the name the ENDPOINT
# answers to, so prefer a stable server-side ALIAS over a runner-specific pull tag:
# `local-workhorse` keeps working when the runner or the underlying artifact changes,
# where `qwen2.5-coder:14b` is Ollama registry syntax that llama-server never sees.
#   Ollama:       ollama cp qwen2.5-coder:14b local-workhorse
#   llama-server: --alias local-workhorse
# The default below is the literal tag because that is what the rig has today; on the box,
# create the alias and set it here.
#   16GB (RTX 5080): qwen2.5-coder:14b
#   24GB (RTX 3090): pick on evidence, not on this comment -- see config/models.txt.
INFERENCE_MODEL=qwen2.5-coder:14b

# Embeddings model for Stage 3 RAG. Same alias advice.
INFERENCE_EMBED_MODEL=nomic-embed-text

# Where your docs live (read-only source for the digest).
WORKSPACE=F:\BIMpossible-Workspace

# Output folder for generated digests (relative to repo root, or absolute).
OUT=./out

# How many days back the daily digest looks.
DIGEST_DAYS=7

# WP-F eval: a task is "local OK" when its pass-rate clears this threshold (0-1).
EVAL_PASS_THRESHOLD=0.8
# Model that grades rubric "judge" criteria (eval/judge.py). Blank = the model under test
# grades itself, which the report flags as self-judged. Use one fixed judge to compare models.
EVAL_JUDGE_MODEL=

# WP-F eval: Claude model used for the optional baseline comparison (only called
# when ANTHROPIC_API_KEY is set).
BASELINE_MODEL=claude-opus-4-8

# OpenWhispr dictation-cleanup proxy (aiserver/dictation_proxy.py). Listen address --
# not the inference endpoint, which is INFERENCE_BASE_URL above.
DICTATION_PROXY_HOST=127.0.0.1
DICTATION_PROXY_PORT=11435

# --- Endpoint-down alert (WP-E, scripts/endpoint_watch.py) ---
# Minutes the endpoint may be unreachable before one alert fires.
ENDPOINT_ALERT_MINUTES=3
# Optional webhook (LAN or tailnet URL only) that receives ALERT/RECOVERED as a JSON POST.
ENDPOINT_ALERT_WEBHOOK=
